//--- Top-N Queries ---


// Top 10 expensive prices
db.products.find({}, {_id: 0, product_name: 1, list_price: 1}).sort({list_price: -1}).limit(10)

// Top 5 Customers with the most orders
db.orders.aggregate([
	{
        $group: {
            _id: "$customer.customer_id",
            first_name: {$first: "$customer.first_name"},
            last_name: {$first: "$customer.last_name"},
            amount_orders: {$sum: 1}
        }
    },
        {
            $sort: {amount_orders: -1}
        },
    {
        $limit: 5
    },
    {
        $project: {
            _id: 0,
            customer_id: "$_id",
            first_name: "$first_name",
            last_name:  "$last_name",
            amount_orders: "$amount_orders"
        }
    }
])

// Top 10 most sold products
db.orders.aggregate([
  {
    $unwind: "$items"
  },
  {
    $group: {
      _id: "$items.product_id",
      sold_units: {$sum: "$items.quantity"}
    }
  },
  {
    $sort: {sold_units: -1}
  },
  {
    $limit: 5
  },
  {
    $lookup: {
      from: "products",
      localField: "_id",
      foreignField: "product_id",
      as: "product_info"
    }
  },
  {
    $unwind: "$product_info"
  },
  {
    $project: {
      _id: 0,
      product_id: "$_id",
      product_name: "$product_info.product_name",
      sold_units: "$sold_units"
    }
  }
])

// Top 5 Sellers
db.orders.aggregate([
  {
    $unwind: "$items"
  },
  {
    $group: {
      _id: "$staff.staff_id",
      first_name: {$first: "$staff.first_name"},
      last_name: {$first: "$staff.last_name"},
      sold_units: {$sum: "$items.quantity"}
    }
  },
  {
    $sort: {sold_units: -1}
  },
  {
    $limit: 5
  },
  {
    $project: {
      _id: 0,
      staff_id: "$_id",
      first_name: "$first_name",
      last_name: "$last_name",
      units_sold: "$sold_units"
    }
  }
])



//--- Queries of Relations between different Entities---


// All orders of one single Customer x
db.orders.find({"customer.customer_id": 1})

// All products of the brand x
db.products.find({"brand.brand_id": 1})

// All Orders where product x was sold
db.orders.find({"items.product_id": 16})



//--- Aggregation and combination of data ---


// Revenue made by each store
db.orders.aggregate([
  {
    $unwind: "$items"
  },
  {
    $group: {
      _id: "$store.store_id",
      store_name: { $first: "$store.store_name" },
      total_revenue: {
        $sum: {
          $multiply: [
            "$items.quantity",
            "$items.list_price",
            { $subtract: [1, "$items.discount"] }
          ]
        }
      }
    }
  },
  { $sort: { total_revenue: -1 } },
  {
    $project: {
      _id: 0,
      store_id: "$_id",
      store_name: "$store_name",
      total_revenue: { $round: ["$total_revenue", 2] }
    }
  }
])


// Average order value per store
db.orders.aggregate([
  {
    $unwind: "$items"
  },
  {
    $group: {
      _id: "$order_id",
      store_id: { $first: "$store.store_id" },
      store_name: { $first: "$store.store_name" },
      order_total: {
        $sum: {
          $multiply: [
            "$items.quantity",
            "$items.list_price",
            { $subtract: [1, "$items.discount"] }
          ]
        }
      }
    }
  },
  {
    $group: {
      _id: "$store_id",
      store_name: { $first: "$store_name" },
      average_order_value: { $avg: "$order_total" }
    }
  },
  { $sort: { average_order_value: -1 } },
  {
    $project: {
      _id: 0,
      store_id: "$_id",
      store_name: "$store_name",
      average_order_value: { $round: ["$average_order_value", 2] }
    }
  }
])


// Amount of order by customer
db.orders.aggregate([
  {
    $group: {
      _id: "$customer.customer_id",
      customer_name: { $first: { $concat: ["$customer.first_name", " ", "$customer.last_name"] } },
      order_count: { $sum: 1 }
    }
  },
  { $sort: { order_count: -1 } },
  {
    $project: {
      _id: 0,
      customer_id: "$_id",
      customer_name: "$customer_name",
      order_count: "$order_count"
    }
  }
])


// Sold units per product
db.orders.aggregate([
  {
    $unwind: "$items"
  },
  {
    $group: {
      _id: "$items.product_id",
      sold_units: { $sum: "$items.quantity" }
    }
  },
  { $sort: { sold_units: -1 } },
  {
    $lookup: {
      from: "products",
      localField: "_id",
      foreignField: "product_id",
      as: "product_info"
    }
  },
  {
    $unwind: "$product_info"
  },
  {
    $project: {
      _id: 0,
      product_id: "$_id",
      product_name: "$product_info.product_name",
      sold_units: "$sold_units"
    }
  }
])

